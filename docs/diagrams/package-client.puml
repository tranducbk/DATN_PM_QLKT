@startuml package-client
' Thiết kế gói phía Client (FE-QLKT). Ánh xạ theo cấu trúc thật src/:
' app=app/ (App Router, route group theo vai trò) · lib/api=wrapper API theo domain
' lib/utils=lib/utils.ts · contexts=React Context (AuthContext, DevZoneContext) · hooks=custom hooks
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 45
title Thiết kế gói phía Client (FE-QLKT)

package "node_modules" as nm
package "public" as pub

package "src" as src {
  package "app" as app
  package "components" as comp
  package "contexts" as ctx
  package "hooks" as hooks
  package "constants" as consts
  package "configs" as cfg
  package "lib" as lib {
    package "api" as api
    rectangle "utils" as utils
  }
}

app ..> comp
app ..> ctx
app ..> hooks
app ..> api
app ..> nm
app ..> pub

comp ..> api
comp ..> ctx
comp ..> hooks
comp ..> utils
comp ..> consts

ctx ..> api
hooks ..> api
api ..> utils
api ..> cfg
@enduml
