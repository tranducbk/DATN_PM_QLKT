@startuml package-detail-personnel
' Thiết kế chi tiết gói — Quản lý quân nhân. Phụ thuộc: Page ..> Component ..> API domain.
' Pages = page.tsx của App Router (app/{admin,manager}/personnel/...). Components có thật trong components/personnel/.
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 45
left to right direction
title Thiết kế chi tiết gói — Quản lý quân nhân

package "Pages (app/personnel)" as pages {
  rectangle "page.tsx\n(danh sách)" as plist
  rectangle "[id]/page.tsx\n(chi tiết)" as pdetail
  rectangle "create + [id]/edit\n(biểu mẫu)" as pfpage
}

package "Components (components/personnel)" as comp {
  rectangle "PersonnelTable" as ptable
  rectangle "PersonnelDetailView" as pdview
  rectangle "PersonnelForm" as pform
  rectangle "PositionHistoryView" as phview
}

package "API (lib/api)" as api {
  rectangle "personnel.ts" as papi
}

plist ..> ptable
pdetail ..> pdview
pdetail ..> phview
pfpage ..> pform

ptable ..> papi
pdview ..> papi
pform ..> papi
phview ..> papi
@enduml
